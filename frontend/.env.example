[TEMPLATE]
# Supabase — Project Settings -> API. Both values are public by design.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Use 127.0.0.1, not localhost. Uvicorn binds IPv4 only by default, and some
# browsers resolve "localhost" to IPv6 (::1) first, which nothing is listening on.
VITE_API_URL=http://127.0.0.1:8000/api

# Cloudflare Turnstile SITE key (public). Leave blank to disable locally.
# The SECRET key belongs in backend/.env and must never appear here.
VITE_TURNSTILE_SITE_KEY=