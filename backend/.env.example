# Both loopback spellings, because the browser's Origin depends on how you
# opened the page. Keep both during local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

APP_NAME=RetailMind AI
ENVIRONMENT=development

OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Cloudflare Turnstile. Leave blank to disable locally.
# The SITE key is public and belongs in the frontend env; only the SECRET here.
TURNSTILE_SECRET_KEY=

# Where Supabase sends the browser back after Google sign-in.
OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Where Supabase sends the browser back after an email confirmation link is
# clicked (the sign-up verification email). Must be allow-listed in Supabase
# under Authentication -> URL Configuration -> Redirect URLs.
# Local development:
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
# Production: use the real domain, e.g.
# AUTH_REDIRECT_URL=https://your-domain.com/auth/callback

# ---------------------------------------------------------------- Email (order notifications)
#
# When a store manager submits an order, the backend emails the manager/admin
# for that store with the order details as an Excel attachment. Configure SMTP
# here — everything stays server-side, never in the frontend.
#
# Leave SMTP_HOST blank to disable email entirely; orders still save and the
# failure is logged instead of losing the order.
#
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=RetailMind AI <no-reply@your-domain.com>

# Comma-separated fallback recipients for order notifications, used when a
# store has no notification_email set and no admin/inventory-manager profile
# can be found. Placeholder only — put a real address in your own .env.
ORDER_NOTIFICATION_EMAILS=

# Optional: an SMTP test/debug endpoint (e.g. Mailtrap) — same variables as above.
# ---------------------------------------------------------------- warehouse email
#
# Where new store orders are sent. Resolution order is:
#   1. system_settings['warehouse.notification_email'] (set from System settings
#      in the app — the preferred place, because it needs no redeploy)
#   2. every active profile with the `warehouse` role
#   3. the store's own notification_email column
#   4. ORDER_NOTIFICATION_EMAILS below
#
# Never put a real personal address in this file. The order always saves even if
# the email fails — delivery is deliberately decoupled from the write.
ORDER_NOTIFICATION_EMAILS=

# SMTP. Leave SMTP_HOST blank to disable email entirely.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# EMAIL_FROM=RetailMind AI <no-reply@yourcompany.com>
